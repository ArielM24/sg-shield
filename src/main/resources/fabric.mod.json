{
	"schemaVersion": 1,
	"id": "sg-shield",
	"version": "${version}",
	"name": "SG Shield",
	"description": "A simple mod to remove the shield delay when blocking",
	"authors": [
		"ArielM24"
	],
	"contact": {
		"homepage": "https://github.com/ArielM24/sg-shield",
		"sources": "https://github.com/ArielM24/sg-shield"
	},
	"license": "CC0-1.0",
	"icon": "assets/sg-shield/sg-shield.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.sg.shield.SGShield"
		],
		"client": [
			"com.sg.shield.SGShieldClient"
		]
	},
	"mixins": [
		"sg-shield.mixins.json",
		{
			"config": "sg-shield.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.7",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}